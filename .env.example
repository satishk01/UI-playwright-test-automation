# ═══════════════════════════════════════════════════════════
#  LLM Provider Configuration
# ═══════════════════════════════════════════════════════════
# Choose one: anthropic | bedrock | azure | openrouter | grok | nvidia | ollama | vllm | omniroute
LLM_PROVIDER=anthropic

# ── Anthropic ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6
# Models: claude-sonnet-4-6, claude-haiku-4-5-20251001, claude-opus-4-6

# ── AWS Bedrock ──────────────────────────────────────────
# LLM_PROVIDER=bedrock
# LLM_MODEL=anthropic.claude-sonnet-4-6-v1
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...        # optional — falls back to instance profile
# AWS_SECRET_ACCESS_KEY=...        # optional — falls back to instance profile
# AWS_SESSION_TOKEN=...            # optional — for assumed roles
# Models: anthropic.claude-*, us.amazon.nova-*, meta.llama3-*, mistral.*

# ── Azure OpenAI ────────────────────────────────────────
# LLM_PROVIDER=azure
# LLM_BASE_URL=https://your-resource.openai.azure.com
# LLM_API_KEY=your-azure-api-key
# LLM_MODEL=gpt-4o
# AZURE_DEPLOYMENT=my-gpt4o-deployment
# AZURE_API_VERSION=2024-10-21
# Models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-4, gpt-35-turbo

# ── OpenRouter ──────────────────────────────────────────
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-...
# LLM_MODEL=anthropic/claude-sonnet-4-6
# LLM_BASE_URL=https://openrouter.ai/api
# Models: anthropic/claude-*, openai/gpt-*, google/gemini-*, meta-llama/*, deepseek/*, qwen/*

# ── Grok (xAI) ─────────────────────────────────────────
# LLM_PROVIDER=grok
# LLM_API_KEY=xai-...
# LLM_MODEL=grok-3-mini
# LLM_BASE_URL=https://api.x.ai
# Models: grok-3, grok-3-mini, grok-3-fast

# ── NVIDIA NIM ──────────────────────────────────────────
# LLM_PROVIDER=nvidia
# LLM_API_KEY=nvapi-...
# LLM_MODEL=meta/llama-3.1-70b-instruct
# LLM_BASE_URL=https://integrate.api.nvidia.com
# For self-hosted: LLM_BASE_URL=http://your-nim-server:8000

# ── Ollama (local) ──────────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:14b
# LLM_BASE_URL=http://localhost:11434

# ── vLLM (self-hosted) ─────────────────────────────────
# LLM_PROVIDER=vllm
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# LLM_BASE_URL=http://localhost:8000
# LLM_API_KEY=token-abc              # if launched with --api-key

# ── OmniRoute (gateway) ────────────────────────────────
# LLM_PROVIDER=omniroute
# LLM_MODEL=default
# LLM_BASE_URL=http://localhost:4000
# LLM_API_KEY=                        # if your gateway requires one

# ═══════════════════════════════════════════════════════════
#  Server
# ═══════════════════════════════════════════════════════════
PORT=3001
NODE_ENV=development

# ═══════════════════════════════════════════════════════════
#  Playwright
# ═══════════════════════════════════════════════════════════
PLAYWRIGHT_TIMEOUT=30000
MAX_CRAWL_DEPTH=3
MAX_PAGES=20

# Timeout for networkidle wait during crawl (seconds as ms). SPAs with
# polling/analytics never reach networkidle — the Explorer falls back to
# domcontentloaded + API settle. Raise this for slow API Gateway/Lambda apps.
NETWORKIDLE_TIMEOUT=10000

# How long to wait for API calls to complete after domcontentloaded fallback
# (ms). Only used when networkidle times out. Raise for Lambda cold starts.
API_SETTLE_TIMEOUT=8000

# ═══════════════════════════════════════════════════════════
#  Pipeline
# ═══════════════════════════════════════════════════════════
MAX_HEAL_ITERATIONS=3
MAX_TESTS_PER_PLAN=4
